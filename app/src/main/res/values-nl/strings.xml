    <string name="settings_media_broadcast_logos">Media Broadcast DAB-logo\'s</string>
    <string name="settings_media_broadcast_logos_hint">Officiële DAB-logo\'s van de netwerkbeheerder, exact per SId toegewezen (beste DAB-dekking). Laadt bij de knop \"Logo\'s laden\" ~23 MB — bij weinig databundel uitschakelen.</string>
    <string name="settings_ip_fallback">Internetstream als terugval</string>
    <string name="settings_ip_fallback_hint">Als DAB en FM beide te zwak zijn, de zender via zijn internetstream verder beluisteren (DAB→FM→internet). Vereist een dataverbinding.</string>
